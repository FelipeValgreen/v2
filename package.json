{
  "name": "rinon-v2-staging",
  "version": "1.0.0-rc.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/reconstruct-visual-assets.mjs",
    "preflight:production": "node scripts/preflight-production.mjs",
    "build": "npm run preflight:production && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "qa:migration": "node scripts/check-migration-contract.mjs",
    "qa:static": "npm run typecheck && npm run qa:migration && npm run preflight:production",
    "qa:served": "node scripts/check-served-build.mjs",
    "qa:remote": "node scripts/check-served-build.mjs",
    "qa:browser": "playwright test",
    "check:release": "npm run qa:static && npm run build && npm run qa:served && npm run qa:browser"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
